# Copy this file to .env only when you need to override the local defaults.
# Never commit real passwords or API keys.

FITPILOT_DB_PASSWORD=fitpilot
JWT_SECRET=replace-with-a-long-random-secret-before-public-deployment
JWT_EXPIRATION_MINUTES=1440

# AI nutrition estimation is optional. Leave empty to disable it.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=25

# Change these only when the default host ports are already occupied.
BACKEND_PORT=8080
WEB_PORT=5173
