# Copy this file to .env only when you need to override the local defaults.
# Never commit real passwords or API keys.

FITPILOT_DB_PASSWORD=fitpilot
JWT_SECRET=replace-with-a-long-random-secret-before-public-deployment
JWT_ISSUER=https://fitpilot.local
JWT_EXPIRATION_MINUTES=1440

# AI nutrition estimation is optional. Leave empty to disable it.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=25

# Change these only when the default host ports are already occupied.
BACKEND_PORT=8080
WEB_PORT=5173

# Login failure protection (Redis runs on the private Compose network).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# For a backend started directly with Maven, use a reachable Redis URL.
# REDIS_URL=redis://localhost:6379
# Trust only your actual reverse proxy IP/CIDR; empty means ignore forwarded IPs.
LOGIN_TRUSTED_PROXIES=

# Optional built-in food search cache; custom foods always come from PostgreSQL.
FOOD_CACHE_ENABLED=true
FOOD_CACHE_TTL_SECONDS=300
